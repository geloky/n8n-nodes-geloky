{
	"name": "n8n-nodes-geloky",
	"version": "0.1.3",
	"description": "n8n node for Geloky: geocode addresses, reverse geocode coordinates and measure road distance and travel time, paid per lookup from your Geloky API wallet.",
	"license": "MIT",
	"homepage": "https://geloky.com/help-api",
	"keywords": [
		"n8n-community-node-package",
		"geloky",
		"geocoding",
		"reverse-geocoding",
		"latitude",
		"longitude",
		"distance",
		"travel-time"
	],
	"author": {
		"name": "Geloky",
		"email": "hello@geloky.com",
		"url": "https://geloky.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/geloky/n8n-nodes-geloky.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/GelokyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Geloky/Geloky.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.57.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
